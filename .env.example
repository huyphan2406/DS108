# Copy this file to .env then fill real values.

# Linux/macOS: set this to your user id with: id -u
# Windows Docker Desktop can keep 50000.
AIRFLOW_UID=50000

# Used by src/_02_*.py and src/_03_*.py when crawling ERA5 from CDS API.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=YOUR_UID:YOUR_API_KEY # Get at https://cds.climate.copernicus.eu/
